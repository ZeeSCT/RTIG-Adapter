# Enable only after the UTC destination has been confirmed.
UTC_TCP_ENABLED=false

# UTC-UX TMC hostname or IP address.
UTC_TCP_HOST=<UTC_HOSTNAME_OR_IP>

# Confirmed RTIG TCP listener port.
UTC_TCP_PORT=<UTC_TCP_PORT>

UTC_TCP_TIMEOUT_MS=10000
UTC_TCP_MAX_MESSAGE_BYTES=4096


# Optional; code currently uses these defaults when omitted
RTIG_RECEIVED_DIRECTORY=C:\UTCAdapter\data\received
RTIG_AUDIT_DIRECTORY=C:\UTCAdapter\logs



